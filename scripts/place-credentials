#!/usr/bin/env bash
#
# Copy the credentials from this machine to the server, and nowhere else.
#
#     scripts/place-credentials
#
# It reads ~/.config/mta-flowers.env, keeps only the names the app actually
# reads, and writes them to /etc/mta-flowers.env over ssh.
#
# # It prints no values
#
# The file goes over ssh on stdin rather than as an argument, so no value
# reaches a command line, the shell history, or the process list on either
# machine. What this prints is a list of names and nothing else.
#
# Note what is NOT sent: VULTR_API_KEY, and the DEPLOY_* values. The Vultr key
# can delete the instance and the instance has no use for it; the deploy key
# belongs to GitHub. A server that cannot destroy itself is worth the one line
# it costs to arrange.
#
# # It connects as root, not as deploy
#
# The deploy account may run one command with two arguments and nothing else,
# and writing /etc/mta-flowers.env is deliberately not among them: that account
# is reachable by anything holding the key in a GitHub secret, and it has no
# business installing credentials. This is an operator action from your own
# machine, over your own key -- the one Vultr put on root at first boot.

set -euo pipefail

env_file=${MTA_FLOWERS_ENV:-$HOME/.config/mta-flowers.env}
test -f "$env_file" || { echo "no credential file at $env_file" >&2; exit 1; }

# shellcheck disable=SC1090
set -a; . "$env_file"; set +a

: "${DEPLOY_HOST:?set DEPLOY_HOST in $env_file -- the server does not exist yet}"

wanted=(
	SMTP_HOST SMTP_PORT SMTP_USERNAME SMTP_PASSWORD MAIL_FROM
	NOTIFY_RECIPIENTS ADMIN_EMAILS ADMIN_FALLBACK_PASSWORD
)

payload="# Written by scripts/place-credentials. Do not edit by hand.
LISTEN_ADDR=127.0.0.1:8080
DATABASE_PATH=/var/lib/mta-flowers/flowers.db
PUBLIC_URL=https://${PUBLIC_HOSTNAME:?set PUBLIC_HOSTNAME}
"

echo "Sending to root@${DEPLOY_HOST}:/etc/mta-flowers.env"
for name in "${wanted[@]}"; do
	value=${!name:-}
	if [ -z "$value" ]; then
		echo "  skipped  $name (empty here)"
		continue
	fi
	printf '  sending  %s (%s chars)\n' "$name" "${#value}"
	payload+="${name}=${value}"$'\n'
done

# printf into ssh's stdin. The remote shell writes it with a restrictive umask
# and then fixes the mode explicitly, so there is no window where the file is
# readable by the app's own user.
printf '%s' "$payload" | ssh "root@${DEPLOY_HOST}" \
	'install -m 0600 -o root -g root /dev/stdin /etc/mta-flowers.env && (systemctl restart mta-flowers 2>/dev/null || true)'

echo "Placed. The service was restarted if it was already running."
